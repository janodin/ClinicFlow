# Replace all change-me placeholders with long random production values before deploy.
DJANGO_ENV=production
SECRET_KEY=change-me-to-a-long-random-secret-placeholder
DEBUG=0
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_HSTS_SECONDS=31536000
# Enable only when all subdomains are HTTPS-only and preload submission is intended.
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1
TRUST_X_FORWARDED_PROTO=1
USE_X_FORWARDED_HOST=0
DB_ENGINE=django.db.backends.postgresql
DB_NAME=kliniassist
DB_USER=kliniassist
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=KliniAssist <noreply@your-domain.com>

# For local development, use the console backend (emails print to terminal):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Shared n8n integration for Messenger tools and website Assistant
# Use unique random values of at least 32 characters; copied placeholders fail deploy checks.
MESSENGER_VERIFY_TOKEN=change-me
MESSENGER_APP_SECRET=change-me
N8N_WEBHOOK_SECRET=change-me
META_MESSENGER_N8N_WEBHOOK_URL=https://your-n8n-host.example/webhook/kliniassist-messenger
ASSISTANT_N8N_WEBHOOK_URL=https://your-n8n-host.example/webhook/kliniassist-widget-assistant
ASSISTANT_N8N_TIMEOUT_SECONDS=12
